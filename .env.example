# Copy this file to .env.local before using a real provider.
PORT=8787

# A separate token sent by the Shortcut to this relay. Do not use your provider key here.
CAPTURE_TOKEN=replace-with-a-long-random-token

# Zeta documents an OpenAI-compatible multimodal chat endpoint.
PROVIDER_API_URL=https://api.zetatechs.com/v1/chat/completions
PROVIDER_API_KEY=replace-with-your-zeta-api-key
PROVIDER_MODEL=replace-with-a-zeta-vision-model-id

# Optional settings.
MAX_IMAGE_BYTES=5242880
PROVIDER_JSON_MODE=false
MOCK_ANALYSIS=false
ALLOW_INSECURE_LOCAL=false

# Set to 0.0.0.0 when you want iPhone on the same LAN to reach this relay.
# Leave empty (or set to 127.0.0.1) for local-only access.
BIND_ADDRESS=0.0.0.0
